<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Logs JSON a stdout (Principio IV). El correlationId se agrega como campo explícito
         en el log de acceso, porque en el gateway reactivo el MDC no se propaga solo. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"gateway"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
