# Copiar a .env y ajustar. Valores de ejemplo para desarrollo local; no usar en producción.

# Base de datos de parqueaderos-service
PARQUEADEROS_DB_NAME=parqueaderos
PARQUEADEROS_DB_USER=parqueaderos
PARQUEADEROS_DB_PASSWORD=cambiar-esta-clave

# Base de datos de vehiculos-service
VEHICULOS_DB_NAME=vehiculos
VEHICULOS_DB_USER=vehiculos
VEHICULOS_DB_PASSWORD=cambiar-esta-clave

# URLs internas (red de Docker)
PARQUEADEROS_URL=http://parqueaderos-service:8081
VEHICULOS_URL=http://vehiculos-service:8082
PARQUEADEROS_TIMEOUT=2s

# API Gateway y frontend
FRONTEND_ORIGIN=http://localhost:4200
GATEWAY_URL=http://gateway:8080
